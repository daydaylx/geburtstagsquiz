# Cloudflare Tunnel - Domain-Modus fuer quiz.disaai.de.
# Host-first auch im Domain-Modus: Host erstellt den Raum, Display verbindet per Popout-Link.
# Kopieren zu .env.tunnel, dann bei Bedarf anpassen.
# Keine Secrets oder echten Cloudflare-Credentials in diese Datei schreiben.

# ── Server ──────────────────────────────────────────────────────────────────
# Gelesen von apps/server/src/config.ts
PORT=3001
HOST=0.0.0.0
# CORS/WebSocket-Origin-Whitelist, kommagetrennt. Enthaelt die lokalen Tunnel-Ziele + Domain-Origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,https://tv.quiz.disaai.de,https://host.quiz.disaai.de,https://play.quiz.disaai.de

# ── WebSocket-Verbindung (alle drei Web-Apps) ───────────────────────────────
# Gelesen von packages/shared-hooks/src/helpers.ts
# Im Tunnel-Modus zeigen alle Web-Apps direkt auf den API-Subdomain.
VITE_SERVER_SOCKET_URL=wss://api.quiz.disaai.de

# ── URL-Konstruktion fuer Host und Display ──────────────────────────────────
# Gelesen von apps/web-host/src/lib/helpers.ts und apps/web-display/src/lib/helpers.ts
# Im Domain-Modus nicht noetig: VITE_PUBLIC_HOST, VITE_PLAYER_PORT entfallen,
# da die Subdomain-Rewrite-Logik automatisch funktioniert.
VITE_DISPLAY_URL=https://tv.quiz.disaai.de
VITE_PLAYER_JOIN_BASE_URL=https://play.quiz.disaai.de

# ── Nur fuer quiz.sh-Dashboard/Browserstart (nicht im TypeScript-Code gelesen) ─────────
VITE_HOST_URL=https://host.quiz.disaai.de
