{
  "$schema": "https://charm.land/crush.json",
  "options": {
    "auto_lsp": true,
    "context_paths": ["AGENTS.md", "CLAUDE.md", "WORKFLOW.md"]
  },
  "permissions": {
    "allowed_tools": ["view", "ls", "glob", "grep", "edit", "write", "bash", "agent", "multiedit"]
  },
  "mcp": {
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    }
  }
}
