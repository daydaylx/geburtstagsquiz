# .env.hybrid.example
# Hybrid-Modus: Host und Display laufen lokal, Player verbinden über Cloudflare Tunnel.
#
# Nutzung mit quiz.sh → Menüpunkt "Hybrid-Modus" empfohlen.
# Für manuellen Start: Werte in .env.local kopieren und anpassen.
#
# Voraussetzung: Cloudflare Tunnel für api.quiz.disaai.de und play.quiz.disaai.de muss bereits laufen.
# Tunnel starten: cloudflared tunnel --config .cloudflared/config.yml run quiz

# --- Server ---
PORT=3001
HOST=0.0.0.0
# Erlaubt lokale Clients (Host/Display) und Tunnel-Clients (Player)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,https://tv.quiz.disaai.de,https://host.quiz.disaai.de,https://play.quiz.disaai.de

# --- Host (localhost:5173) ---
# VITE_SERVER_SOCKET_URL=ws://localhost:3001
# VITE_DISPLAY_URL=http://localhost:5175
# VITE_PLAYER_JOIN_BASE_URL=https://play.quiz.disaai.de

# --- Display (localhost:5175) ---
# VITE_SERVER_SOCKET_URL=ws://localhost:3001
# VITE_PLAYER_JOIN_BASE_URL=https://play.quiz.disaai.de

# --- Player (localhost:5174, öffentlich via Tunnel erreichbar) ---
# VITE_SERVER_SOCKET_URL=wss://api.quiz.disaai.de
# VITE_PLAYER_JOIN_BASE_URL=https://play.quiz.disaai.de

# Hinweis: quiz.sh setzt die per-App unterschiedlichen VITE_SERVER_SOCKET_URL-Werte
# automatisch beim Start. Bei manuellem Start muss jede App separat gestartet werden.
