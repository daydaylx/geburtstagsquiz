# Lokale Entwicklung auf dem Laptop.
# Host-first: http://localhost:5173 erstellt den Raum und oeffnet Display http://localhost:5175.
# Kopieren zu .env.local, dann bei Bedarf anpassen.

# ── Server ──────────────────────────────────────────────────────────────────
# Gelesen von apps/server/src/config.ts
PORT=3001
HOST=0.0.0.0
# CORS/WebSocket-Origin-Whitelist, kommagetrennt
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# ── WebSocket-Verbindung (alle drei Web-Apps) ───────────────────────────────
# Gelesen von packages/shared-hooks/src/helpers.ts
# Ohne diese Variable nutzen die Frontends den Vite-Proxy /ws -> ws://localhost:3001
VITE_SERVER_SOCKET_URL=ws://localhost:3001

# ── URL-Konstruktion fuer Host und Display ──────────────────────────────────
# Gelesen von apps/web-host/src/lib/helpers.ts und apps/web-display/src/lib/helpers.ts
VITE_PUBLIC_HOST=localhost
VITE_PLAYER_PORT=5174
VITE_DISPLAY_URL=http://localhost:5175
VITE_PLAYER_JOIN_BASE_URL=http://localhost:5174

# ── Nur fuer quiz.sh-Startmenue (nicht im TypeScript-Code gelesen) ─────────
VITE_HOST_PORT=5173
VITE_HOST_URL=http://localhost:5173
